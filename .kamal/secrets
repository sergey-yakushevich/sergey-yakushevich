KAMAL_REGISTRY_PASSWORD=$(gh auth token 2>/dev/null || echo $KAMAL_REGISTRY_PASSWORD)

# Generated once on first deploy; the app has no DB tables, so a fresh key is safe.
SECRET_KEY_BASE=$([ -s .kamal/secret_key_base ] || bin/rails secret > .kamal/secret_key_base; cat .kamal/secret_key_base)

# Central trackhub visitor-tracking API token (from local ENV at deploy time)
TRACKHUB_TOKEN=$(cat .kamal/trackhub_token 2>/dev/null || echo $TRACKHUB_TOKEN)
