<% content_for :title, @niche ? "#{@niche[:card_title]}. You pay nothing. — cyberjosef" : "I'll build your audience an app. You pay nothing. — cyberjosef" %>

<header class="header">
  <div class="page">
    <a class="wordmark" href="<%= root_path %>">cyberjosef</a>
    <div class="header-actions">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
      <a class="btn btn--primary btn--sm" href="#start">Get your app</a>
    </div>
  </div>
</header>

<main>

  <section style="padding: 64px 0 8px">
    <div class="page">
      <div class="hero-grid">
        <div>
          <h1 class="display-xl" style="max-width:18ch">I'll build your audience an app. You pay nothing.</h1>

          <p class="body muted" style="font-size:17px; line-height:1.5; max-width:44ch; margin:16px 0 28px">
            You post about it — I do everything else. Code, servers, support: every bill is mine.
            The app earns money, we split it 50/50. Every month.
          </p>

          <div class="row gap-3">
            <a class="btn btn--primary" href="#start">Get your app</a>
            <a class="btn btn--outline" href="#how">How it works</a>
          </div>
        </div>

        <div class="hero-card-slot">
          <div class="access-card" data-tilt-card>
            <div class="access-card-bg"></div>
            <div class="access-card-edge"></div>

            <div class="access-card-head">
              <span class="mark" data-card-mark aria-hidden="true"></span>
              <p class="card-title"><%= @niche ? @niche[:card_title] : "Your audience's app" %></p>
              <p class="card-label">Partner access</p>
              <p class="card-label gap">Founding partner · 50/50</p>
              <p class="card-name">Your brand</p>
            </div>

            <p class="card-role"><%= @niche ? @niche[:card_role] : "Creator" %></p>
            <div class="card-qr" data-card-qr aria-hidden="true"></div>
          </div>
        </div>
      </div>

      <div class="grid g3" style="margin-top:40px; padding-top:24px; border-top:1px solid var(--sss-hairline); gap:24px">
        <div>
          <div class="h1 tnum">$0</div>
          <p class="micro faint">What you pay. Ever.</p>
        </div>
        <div>
          <div class="h1 tnum">50%</div>
          <p class="micro faint">Yours, paid every month</p>
        </div>
        <div>
          <div class="h1 tnum">4 apps</div>
          <p class="micro faint">Shipped solo, all live right now</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="section-head"><h2 class="h2">You risk nothing here</h2></div>
      <div class="grid g3">
        <div class="card">
          <span class="chip chip--accent" aria-hidden="true">✓</span>
          <h3 class="h3" style="margin:12px 0 8px">Not a dollar from you</h3>
          <p class="body-sm muted">Design, code, servers, app stores, support. I pay for all of it. There is no invoice later.</p>
        </div>
        <div class="card">
          <span class="chip chip--accent" aria-hidden="true">✓</span>
          <h3 class="h3" style="margin:12px 0 8px">Terms in writing, before any code</h3>
          <p class="body-sm muted">We sign one page of terms first. Either of us can walk away at any point. Nobody gets locked in.</p>
        </div>
        <div class="card">
          <span class="chip chip--accent" aria-hidden="true">✓</span>
          <h3 class="h3" style="margin:12px 0 8px">Worst case: you gave your audience a free tool</h3>
          <p class="body-sm muted">If the app flops, I lose two months of work. You lose nothing — a free tool can't hurt the trust you built.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="page">
      <div class="section-head">
        <h2 class="h2">How you get an app without paying for it</h2>
        <p class="body measure">Five steps. Your total time: two calls and a few posts.</p>
      </div>

      <% steps = [
        { n: "01", title: "We pick the app", we_when: "1 call",
          we: ["I check what already sells in your niche",
               "We pick one tool your audience keeps asking for",
               "We sign the terms — one page, plain words"],
          you_when: "1 hour", you: "Tell me what your audience complains about. You already know." },
        { n: "02", title: "I build it", we_when: "4–8 weeks",
          we: ["Your name and your look — to your audience it's your app",
               "I pay every bill",
               "You get progress builds, not a surprise at the end"],
          you_when: "0 min", you: "Nothing. React to a screenshot if you feel like it." },
        { n: "03", title: "Your audience tries it free", we_when: "2–4 weeks",
          we: ["I run the beta and answer every user myself",
               "We see what people actually use before anyone pays"],
          you_when: "1 post", you: "Announce a free tool. The easiest post you'll make all year." },
        { n: "04", title: "We fix what the beta showed", we_when: "1–2 weeks",
          we: ["Feedback goes into the app the same week", "I bring pricing options based on real usage"],
          you_when: "30 min", you: "One call: we pick the price together." },
        { n: "05", title: "We launch. The money starts", we_when: "Every month",
          we: ["I run servers, support and updates",
               "Money splits 50/50, paid out monthly",
               "You see the payment dashboard itself — not my screenshots"],
          you_when: "Your call", you: "Post when it fits. Every post now grows a thing you half-own." }
      ] %>

      <% steps.each do |step| %>
        <div style="margin-top:20px">
          <div class="row" style="gap:10px; margin-bottom:8px">
            <span class="micro faint tnum"><%= step[:n] %></span>
            <h3 class="h3"><%= step[:title] %></h3>
          </div>
          <div class="grid g2">
            <div class="card" style="padding:16px 18px">
              <div class="row" style="justify-content:space-between; margin-bottom:10px">
                <span class="label">What I do</span>
                <span class="chip"><%= step[:we_when] %></span>
              </div>
              <ul style="margin:0; padding-left:18px">
                <% step[:we].each do |line| %>
                  <li class="body-sm muted" style="margin-bottom:4px"><%= line %></li>
                <% end %>
              </ul>
            </div>
            <div class="card card--sunk" style="padding:16px 18px">
              <div class="row" style="justify-content:space-between; margin-bottom:10px">
                <span class="label">What you do</span>
                <span class="chip"><%= step[:you_when] %></span>
              </div>
              <ul style="margin:0; padding-left:18px">
                <li class="body-sm muted"><%= step[:you] %></li>
              </ul>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="section-head">
        <h2 class="h2"><%= @niche ? @niche[:proof_head] : "Apps like this already print money" %></h2>
        <p class="body measure"><%= @niche ? @niche[:proof_sub] : "Small teams in paying niches, public numbers. Your audience already pays for tools like these — just not for yours yet." %></p>
      </div>

      <div class="marquee">
        <div class="marquee-track">
          <% (@proof_apps * 2).each do |app| %>
            <div class="proof-card">
              <div class="proof-top">
                <h3 class="h3"><%= app[:name] %></h3>
                <img class="proof-logo" src="https://www.google.com/s2/favicons?domain=<%= app[:domain] %>&sz=128" alt="<%= app[:name] %> logo" loading="lazy">
              </div>
              <div class="proof-revenue"><%= app[:stat] %></div>
              <p class="micro faint" style="margin-top:4px"><%= app[:stat_label] %></p>
              <p class="body-sm muted" style="margin-top:10px"><%= app[:note] %></p>
            </div>
          <% end %>
        </div>
      </div>
      <p class="micro faint" style="margin-top:14px">Public numbers: funding announcements, Starter Story, founder interviews. Rounded. Not my apps — the point is that the market pays.</p>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="section-head">
        <h2 class="h2">A sponsored post pays once. An app pays every month.</h2>
        <p class="body measure">You know the treadmill: negotiate, post, get paid, start over. An app doesn't reset to zero on the 1st.</p>
      </div>

      <div class="grid g2">
        <div class="card">
          <p class="label muted" style="margin-bottom:8px">Where the money goes</p>
          <div class="table-wrap">
            <table class="dtable">
              <tbody>
                <tr>
                  <td data-label="Split">Revenue split</td>
                  <td class="num">50 / 50</td>
                </tr>
                <tr>
                  <td data-label="Development">Code, servers, support</td>
                  <td class="num">I pay</td>
                </tr>
                <tr>
                  <td data-label="Promotion">Posts to your audience</td>
                  <td class="num">you post</td>
                </tr>
                <tr>
                  <td data-label="Payout">Payout</td>
                  <td class="num">monthly</td>
                </tr>
                <tr>
                  <td data-label="Duration">For how long</td>
                  <td class="num">as long as it sells</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <p class="label muted" style="margin-bottom:8px">At $10/month per subscriber</p>
          <div class="table-wrap">
            <table class="dtable">
              <thead>
                <tr><th>Paying users</th><th class="num">App earns / mo</th><th class="num">You get / mo</th></tr>
              </thead>
              <tbody>
                <tr><td data-label="Paying users">200</td><td class="num">$2,000</td><td class="num paid">$1,000</td></tr>
                <tr><td data-label="Paying users">500</td><td class="num">$5,000</td><td class="num paid">$2,500</td></tr>
                <tr><td data-label="Paying users">2,000</td><td class="num">$20,000</td><td class="num paid">$10,000</td></tr>
              </tbody>
            </table>
          </div>
          <p class="micro faint" style="margin-top:14px">
            Arithmetic, not a promise — your audience sets the first column.
            But a $2,500 month here repeats next month. A $2,500 sponsorship doesn't.
          </p>
        </div>
      </div>

      <div class="card card--accent" style="margin-top:16px">
        <h3 class="h3" style="margin-bottom:8px">The end goal</h3>
        <p class="body-sm muted measure">
          Money that arrives whether you posted this month or not. You stop renting
          your audience out to other people's products — and start owning half of one
          built just for them.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="section-head"><h2 class="h2">Who am I</h2></div>

      <div class="card">
        <p class="h3">Sergey Yakushevich</p>
        <p class="micro faint" style="margin-top:4px">Senior backend engineer · Batumi, Georgia</p>
        <p class="body-sm muted" style="margin-top:12px; max-width:68ch">
          10 years building backends. 5 of them in payment systems that processed
          350M+ payments. Guarding money in software is my day job — handy, since
          your revenue will run through the app I build.
        </p>
        <p class="body-sm muted" style="margin-top:12px; max-width:68ch">
          I got tired of renting my hours to a 9–5. So I shipped 4 products alone,
          start to finish — they're below, all live. I can build things people pay
          for. What I don't have is your audience. That's the deal: my product,
          your trust.
        </p>
        <div class="row gap-3" style="margin-top:20px">
          <a class="btn btn--outline btn--sm" href="https://cyberjosef.dev" target="_blank" rel="noopener">cyberjosef.dev</a>
          <a class="btn btn--outline btn--sm" href="https://x.com/muffinmanin" target="_blank" rel="noopener">X</a>
          <a class="btn btn--outline btn--sm" href="https://www.instagram.com/sergeyayya_" target="_blank" rel="noopener">Instagram</a>
          <a class="btn btn--outline btn--sm" href="https://github.com/sergey-yakushevich" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>

      <div style="margin-top:40px">
        <div class="row" style="justify-content:space-between; margin-bottom:20px">
          <div>
            <h3 class="h3">4 apps, built alone, all live</h3>
            <p class="body-sm muted" style="margin-top:6px">Click any of them — they're real and running.</p>
          </div>
          <div class="row" style="gap:8px">
            <button type="button" class="carousel-nav" data-carousel-nav="apps-carousel" data-prev aria-label="Previous app">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button type="button" class="carousel-nav" data-carousel-nav="apps-carousel" aria-label="Next app">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6" />
              </svg>
            </button>
          </div>
        </div>

        <div class="carousel" id="apps-carousel">
          <% @projects.each do |project| %>
            <div class="card">
              <img class="carousel-img" src="<%= project[:image] %>" alt="<%= project[:title] %>" loading="lazy">
              <div class="carousel-body">
                <div class="row" style="justify-content:space-between; gap:8px">
                  <h4 class="h3"><%= project[:title] %></h4>
                  <span class="chip"><%= project[:category] %></span>
                </div>
                <p class="body-sm muted"><%= project[:description] %></p>
                <div class="row-chips">
                  <% project[:tech_stack].each do |tech| %>
                    <span class="chip"><%= tech %></span>
                  <% end %>
                </div>
                <a class="link body-sm" href="<%= project[:link][:href] %>" target="_blank" rel="noopener"><%= project[:link][:label] %></a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="start">
    <div class="page">
      <div class="grid g2" style="align-items:start">
        <div>
          <h2 class="h2" style="margin-bottom:12px">The whole deal on one card</h2>
          <p class="body muted measure">No tiers. No invoices. No retainer. I carry the build risk, you carry the launch, and the split never changes.</p>

          <div class="card card--accent" style="margin-top:24px">
            <h3 class="h3" style="margin-bottom:10px">If it flops</h3>
            <p class="body-sm muted">You've spent two calls and a few posts about a free tool. I've spent two months of work. You owe me nothing. That asymmetry is on purpose — I only win if you do.</p>
          </div>
        </div>

        <div class="card" style="border-radius:var(--sss-radius-sheet); padding:28px">
          <p class="label muted">Your share</p>
          <div class="row" style="align-items:baseline; gap:10px; margin:6px 0 4px">
            <span class="tnum" style="font-size:clamp(40px,10vw,52px); font-weight:700; letter-spacing:-0.03em; line-height:1">50%</span>
            <span class="body muted">of revenue, monthly</span>
          </div>
          <p class="micro faint" style="margin-bottom:22px">for as long as the app is sold</p>

          <ul style="list-style:none; margin:0; padding:0">
            <% [
              ["You pay $0.", "Code, servers, stores, support — all on me."],
              ["Your brand on it.", "Your name, your look. My name stays in the code."],
              ["Free beta first.", "Your audience pays nothing until the app is good."],
              ["Terms in writing", "before any code. Either side can walk away."],
              ["You see the real numbers.", "The payment dashboard itself, not screenshots."],
              ["No exclusivity, no post quota, no deadline.", nil]
            ].each do |strong, rest| %>
              <li class="body-sm muted" style="padding:10px 0; border-top:1px solid var(--sss-hairline)">
                <strong style="color:var(--sss-ink); font-weight:600"><%= strong %></strong>
                <%= " #{rest}" if rest %>
              </li>
            <% end %>
          </ul>

          <a class="btn btn--primary" style="width:100%; margin-top:24px"
             href="mailto:sergeyayya@gmail.com?subject=<%= u("App partnership") %>">Get your app</a>
          <p class="micro faint" style="text-align:center; margin-top:12px">
            Reply to the message that brought you here, or write to
            <a class="link" href="mailto:sergeyayya@gmail.com">sergeyayya@gmail.com</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page">
      <div class="section-head"><h2 class="h2">Straight answers</h2></div>
      <% [
        ["What does this cost me?",
         "$0. Your cost is time: two calls and a few posts. Every bill — code, servers, stores, support — is mine."],
        ["Why would you build a whole app for free?",
         "It's not free, it's a bet. I'm betting two months of work that your audience buys. If I wanted to sell hours, I'd send a quote. I'd rather own half of something that pays for years."],
        ["Who owns the app?",
         "We write it down before I start: the brand and audience are yours, the code is mine. Neither of us can sell the product without the other."],
        ["What if it flops?",
         "You're out a few posts about a free tool. I'm out two months. You owe me nothing — no clawback, no invoice later."],
        ["How do I know the money numbers are real?",
         "You get a login to the payment dashboard — the same screen I see. Not an export I prepared."],
        ["What if we fall out a year in?",
         "The written terms cover it: either side can stop, and the split stays on what the app keeps earning. Nobody gets held hostage."],
        ["My audience is small. Does this still work?",
         "Trust beats size. 5,000 people who act on your advice beat 100,000 who scroll past. If people DM you questions, that's the signal I want."],
        ["Why do you get half? It's my audience.",
         "Flip it: why do you get half of my code? Because neither half works alone. Your audience without a product earns sponsorship money. My product without an audience earns zero. Together they earn monthly."]
      ].each do |question, answer| %>
        <details>
          <summary>
            <%= question %>
            <span class="faint" aria-hidden="true" style="font-size:20px; line-height:1; flex:none">+</span>
          </summary>
          <p class="body-sm muted"><%= answer %></p>
        </details>
      <% end %>
    </div>
  </section>

  <section class="section">
    <div class="page" style="text-align:center; padding-top:24px">
      <h2 class="h1" style="margin-bottom:12px">Not sure what fits your audience?</h2>
      <p class="body muted" style="margin:0 auto 24px; max-width:50ch">Send me your channel. I'll look properly and answer honestly — even if the answer is "no app, keep taking sponsorships".</p>
      <a class="btn btn--primary" href="mailto:sergeyayya@gmail.com?subject=<%= u("App partnership") %>">Send your channel</a>
    </div>
  </section>

</main>

<footer class="footer">
  <div class="page">
    <div>
      <span class="wordmark" style="display:block">cyberjosef</span>
      <p class="micro faint" style="margin-top:8px">Sergey Yakushevich · <a class="link" href="https://cyberjosef.dev">cyberjosef.dev</a> · <a class="link" href="mailto:sergeyayya@gmail.com">sergeyayya@gmail.com</a></p>
    </div>
  </div>
</footer>
