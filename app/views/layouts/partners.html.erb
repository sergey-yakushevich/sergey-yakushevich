<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= content_for(:title) || "Partner with a developer — 50/50 app for your audience" %></title>
    <meta name="description" content="<%= content_for(:description) || "I build and pay for an app under your brand. You launch it to your audience. We split the revenue 50/50, every month." %>">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' fill='none' stroke='%2316A34A' stroke-width='5.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M32 5.5 55 18.75 55 45.25 32 58.5 9 45.25 9 18.75Z'/%3E%3Cpath d='M32 12.5 32 27'/%3E%3Cpath d='M48.5 37 37 43.7'/%3E%3Cpath d='M15.5 37 27 43.7'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      :root {
        --sss-bg:           #FFFFFF;
        --sss-surface:      #FAFAFA;
        --sss-surface-sunk: #F0F0F0;
        --sss-hairline:     rgba(0, 0, 0, 0.1);

        --sss-ink:          #0A0A0A;
        --sss-ink-muted:    #525252;
        --sss-ink-faint:    #A3A3A3;
        --sss-ink-inverse:  #FFFFFF;

        --sss-accent:       #16A34A;
        --sss-accent-deep:  #15803D;
        --sss-accent-tint:      rgba(22, 163, 74, 0.08);
        --sss-accent-tint-line: rgba(22, 163, 74, 0.3);

        --sss-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, ui-sans-serif, system-ui, sans-serif;

        --sss-text-micro: 12px;
        --sss-text-label: 13px;
        --sss-text-body-sm: 14px;
        --sss-text-body: 15px;
        --sss-text-h3: 16px;
        --sss-text-h2: 28px;
        --sss-text-h1: 32px;
        --sss-text-display-xl: 52px;

        --sss-radius-sm: 10px;
        --sss-radius: 12px;
        --sss-radius-lg: 14px;
        --sss-radius-sheet: 24px;

        --sss-page-max: 1040px;
        --sss-page-pad: 32px;
        --sss-section-gap: 80px;
        --sss-control-block: 52px;

        --sss-ease: cubic-bezier(0.2, 0, 0, 1);
        --sss-fast: 120ms;
        --sss-base: 200ms;
      }

      .dark {
        color-scheme: dark;

        --sss-bg:           #000000;
        --sss-surface:      #0A0A0A;
        --sss-surface-sunk: #1A1A1A;
        --sss-hairline:     rgba(255, 255, 255, 0.1);

        --sss-ink:          #FFFFFF;
        --sss-ink-muted:    #A3A3A3;
        --sss-ink-faint:    #6E6E6E;
        --sss-ink-inverse:  #0A0A0A;

        --sss-accent:       #4ADE80;
        --sss-accent-deep:  #86EFAC;
        --sss-accent-tint:      rgba(74, 222, 128, 0.1);
        --sss-accent-tint-line: rgba(74, 222, 128, 0.25);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--sss-bg);
        color: var(--sss-ink);
        font-family: var(--sss-font-sans);
        font-size: var(--sss-text-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }

      img { max-width: 100%; display: block; }
      a { color: inherit; }

      .display-xl { font-size: clamp(28px, 7vw, var(--sss-text-display-xl)); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; margin: 0; }
      .h1  { font-size: var(--sss-text-h1); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
      .h2  { font-size: var(--sss-text-h2); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }
      .h3  { font-size: var(--sss-text-h3); font-weight: 700; letter-spacing: -0.01em; margin: 0; }
      .body     { font-size: var(--sss-text-body); line-height: 1.6; margin: 0; }
      .body-sm  { font-size: var(--sss-text-body-sm); line-height: 1.6; margin: 0; }
      .label    { font-size: var(--sss-text-label); font-weight: 500; margin: 0; }
      .micro    { font-size: var(--sss-text-micro); line-height: 1.5; margin: 0; }
      .muted    { color: var(--sss-ink-muted); }
      .faint    { color: var(--sss-ink-faint); }
      .tnum     { font-feature-settings: "tnum"; }
      .measure  { max-width: 58ch; }

      .page {
        max-width: var(--sss-page-max);
        margin-inline: auto;
        padding-left: max(var(--sss-page-pad), env(safe-area-inset-left));
        padding-right: max(var(--sss-page-pad), env(safe-area-inset-right));
      }
      .section { margin-top: var(--sss-section-gap); }
      .section-head { margin-bottom: 32px; }
      .section-head .h2 + .body { margin-top: 12px; color: var(--sss-ink-muted); }

      .grid { display: grid; gap: 16px; }
      .g2 { grid-template-columns: repeat(2, 1fr); }
      .g3 { grid-template-columns: repeat(3, 1fr); }
      .g4 { grid-template-columns: repeat(4, 1fr); }

      .gap-3 { gap: 12px }
      .row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }

      .card {
        background: var(--sss-surface);
        border: 1px solid var(--sss-hairline);
        border-radius: var(--sss-radius-lg);
        padding: 24px;
      }
      .card--sunk { background: var(--sss-surface-sunk); }
      .card--accent { border-color: var(--sss-accent-tint-line); background: var(--sss-accent-tint); }

      .chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--sss-surface-sunk);
        border: 1px solid var(--sss-hairline);
        font-size: var(--sss-text-micro);
        font-weight: 500;
        color: var(--sss-ink-muted);
        white-space: nowrap;
      }
      .chip--accent {
        background: var(--sss-accent-tint);
        border-color: var(--sss-accent-tint-line);
        color: var(--sss-accent);
      }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: var(--sss-control-block);
        padding: 12px 24px;
        border-radius: var(--sss-radius);
        font-size: var(--sss-text-h3);
        font-weight: 600;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background var(--sss-fast) var(--sss-ease);
      }
      .btn--primary { background: var(--sss-ink); color: var(--sss-ink-inverse); border: 0; }
      .btn--primary:hover { background: color-mix(in srgb, var(--sss-ink), var(--sss-bg) 12%); }
      .btn--outline { background: transparent; color: var(--sss-ink); border: 1px solid var(--sss-hairline); }
      .btn--outline:hover { background: var(--sss-surface-sunk); }
      .btn--sm { min-height: 40px; padding: 8px 14px; font-size: var(--sss-text-body-sm); }
      .link { color: var(--sss-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--sss-ink-faint); }
      .link:hover { text-decoration-color: var(--sss-ink); }

      .header {
        display: flex; align-items: center;
        min-height: 68px;
        background: transparent;
        border-bottom: 1px solid var(--sss-hairline);
      }
      .header .page { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding-top: 10px; padding-bottom: 10px; }
      .header-actions { display: flex; align-items: center; gap: 8px; }
      .wordmark { font-weight: 700; letter-spacing: -0.02em; font-size: 18px; text-decoration: none; }

      .theme-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 40px; height: 40px;
        flex: none;
        padding: 0;
        border-radius: var(--sss-radius-sm);
        border: 1px solid var(--sss-hairline);
        background: transparent;
        color: var(--sss-ink-muted);
        cursor: pointer;
        transition: background var(--sss-fast) var(--sss-ease), color var(--sss-fast) var(--sss-ease);
      }
      .theme-toggle:hover { background: var(--sss-surface-sunk); color: var(--sss-ink); }
      .theme-toggle svg { width: 18px; height: 18px; }
      .theme-toggle .icon-sun { display: none; }
      .dark .theme-toggle .icon-sun { display: block; }
      .dark .theme-toggle .icon-moon { display: none; }

      .carousel-wrap { position: relative; }
      .carousel {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-left: 2px;
        padding: 2px 2px 12px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .carousel::-webkit-scrollbar { display: none; }
      .carousel .card {
        flex: 0 0 min(340px, 82vw);
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
      }
      .carousel-img {
        aspect-ratio: 16 / 10;
        width: 100%;
        object-fit: cover;
        border-bottom: 1px solid var(--sss-hairline);
      }
      .carousel-body { display: flex; flex-direction: column; flex: 1; gap: 10px; padding: 18px; }
      .carousel-body .row-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
      .carousel-nav {
        display: inline-flex; align-items: center; justify-content: center;
        width: 40px; height: 40px;
        padding: 0;
        border-radius: var(--sss-radius-sm);
        border: 1px solid var(--sss-hairline);
        background: transparent;
        color: var(--sss-ink-muted);
        cursor: pointer;
        transition: background var(--sss-fast) var(--sss-ease), color var(--sss-fast) var(--sss-ease);
      }
      .carousel-nav:hover { background: var(--sss-surface-sunk); color: var(--sss-ink); }
      .carousel-nav svg { width: 18px; height: 18px; }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 48px;
        align-items: center;
      }
      .hero-card-slot { display: flex; justify-content: center; padding: 12px 20px; }

      .access-card {
        --card-metal: linear-gradient(203.33deg, #111111 1.16%, #333333 14.27%, #555555 34.09%, #444444 53.64%, #222222 80.17%, #111111 100%);
        --card-ink: #FFFFFF;
        --card-ink-muted: rgba(255, 255, 255, 0.4);
        --card-edge: rgba(255, 255, 255, 0.14);
        position: relative;
        width: 272px;
        height: 336px;
        overflow: hidden;
        border-radius: 12px;
        transition: transform .3s ease-out;
        will-change: transform;
        box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.5);
      }
      .dark .access-card {
        --card-metal: linear-gradient(203.33deg, #8A8A8E 1.16%, #D8D8DC 14.27%, #EFEFF3 34.09%, #C4C4C8 53.64%, #9A9A9E 77.55%, #7E7E82 100%);
        --card-ink: #222226;
        --card-ink-muted: rgba(0, 0, 0, 0.45);
        --card-edge: rgba(255, 255, 255, 0.35);
      }
      .access-card-bg {
        position: absolute; inset: 0; border-radius: 12px;
        background: var(--card-metal);
      }
      .access-card-edge {
        position: absolute; inset: 0; z-index: 20;
        border-radius: 12px;
        border: 1px solid var(--card-edge);
        pointer-events: none;
      }
      .access-card-head {
        position: absolute; left: 22px; top: 28px; z-index: 10;
        display: flex; flex-direction: column; text-align: left;
      }
      .access-card .mark { display: block; height: 46px; width: 42px; background-color: var(--card-ink); }
      .access-card .card-title {
        margin: 12px 0 0; font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
        color: var(--card-ink);
      }
      .access-card .card-label {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        margin: 5px 0 0; font-size: 10px; font-weight: 500;
        text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--card-ink-muted);
      }
      .access-card .card-label.gap { margin-top: 54px; }
      .access-card .card-name {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        margin: 5px 0 0; font-size: 14px; font-weight: 500;
        text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--card-ink);
      }
      .access-card .card-role {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        position: absolute; left: 22px; bottom: 20px; z-index: 10;
        margin: 0; font-size: 10px; font-weight: 500;
        text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--card-ink-muted);
      }
      .access-card .card-qr {
        position: absolute; right: 20px; bottom: 20px; z-index: 10;
        height: 50px; width: 50px;
        background-color: var(--card-ink); opacity: 0.5;
      }

      .marquee {
        overflow: hidden;
        mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
      }
      .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee-scroll 45s linear infinite;
      }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      @keyframes marquee-scroll { to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) {
        .marquee-track { animation: none; }
        .marquee { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
      }
      .proof-card {
        flex: 0 0 280px;
        margin-right: 16px;
        background: var(--sss-surface);
        border: 1px solid var(--sss-hairline);
        border-radius: var(--sss-radius-lg);
        padding: 20px;
      }
      .proof-card .proof-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; }
      .proof-card .proof-logo {
        width: 36px; height: 36px; flex: none;
        border-radius: 8px;
        border: 1px solid var(--sss-hairline);
        background: #FFFFFF;
        object-fit: contain;
        padding: 4px;
      }
      .proof-card .proof-revenue {
        font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;
        color: var(--sss-accent);
        font-feature-settings: "tnum";
      }

      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .dtable { width: 100%; border-collapse: collapse; font-size: var(--sss-text-body-sm); font-feature-settings: "tnum"; }
      .dtable th {
        text-align: left; font-size: var(--sss-text-micro); font-weight: 500;
        color: var(--sss-ink-faint); padding: 12px 16px;
        border-bottom: 1px solid var(--sss-hairline); white-space: nowrap;
      }
      .dtable td { padding: 12px 16px; border-bottom: 1px solid var(--sss-hairline); color: var(--sss-ink-muted); vertical-align: top; }
      .dtable tbody tr:last-child td { border-bottom: 0; }
      .dtable .num { text-align: right; white-space: nowrap; }
      .dtable .paid { color: var(--sss-accent); font-weight: 600; }

      details { border-bottom: 1px solid var(--sss-hairline); }
      summary {
        list-style: none; cursor: pointer; padding: 18px 0;
        font-size: var(--sss-text-h3); font-weight: 600;
        display: flex; justify-content: space-between; gap: 16px; align-items: center;
      }
      summary::-webkit-details-marker { display: none; }
      details p { padding: 0 0 20px; max-width: 68ch; }

      .footer { margin-top: 80px; border-top: 1px solid var(--sss-hairline); padding: 32px 0 48px; }
      .footer .page { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }

      @media (max-width: 900px) {
        .g3, .g4 { grid-template-columns: repeat(2, 1fr); }
        .hero-grid { grid-template-columns: 1fr; gap: 36px; }
        .hero-card-slot { padding: 4px 0 0; }
      }

      @media (max-width: 559px) {
        :root {
          --sss-text-h1: 24px;
          --sss-text-h2: 21px;
          --sss-page-pad: 16px;
          --sss-section-gap: 48px;
        }
        .g2, .g3, .g4 { grid-template-columns: 1fr; }
        .card { padding: 18px; }
        .measure { max-width: none; }
        .btn { width: 100%; }
        .btn--sm, .header .btn { width: auto; }
        .footer .page { flex-direction: column; align-items: flex-start; }
        .access-card { width: 248px; height: 306px; }
        .proof-card { flex-basis: 240px; }
        .proof-card .proof-revenue { font-size: 22px; }
      }
    </style>

    <%= javascript_tag do %>
      (function () {
        try {
          var dark = localStorage.getItem('partners-theme') === 'dark';
          if (dark) document.documentElement.classList.add('dark');
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    <% end %>
  </head>

  <body>
    <%= yield %>

    <%= javascript_tag do %>
      document.addEventListener('click', function (event) {
        var toggle = event.target.closest('[data-theme-toggle]');
        if (toggle) {
          var dark = document.documentElement.classList.toggle('dark');
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          try { localStorage.setItem('partners-theme', dark ? 'dark' : 'light'); } catch (e) {}
          return;
        }

        var nav = event.target.closest('[data-carousel-nav]');
        if (nav) {
          var track = document.getElementById(nav.getAttribute('data-carousel-nav'));
          if (!track) return;
          var card = track.querySelector('.card');
          var step = card ? card.getBoundingClientRect().width + 16 : 340;
          track.scrollBy({ left: nav.hasAttribute('data-prev') ? -step : step, behavior: 'smooth' });
        }
      });

      (function () {
        var card = document.querySelector('[data-tilt-card]');
        if (!card) return;

        var cubeSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="#000" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"><path d="M32 5.5 55 18.75 55 45.25 32 58.5 9 45.25 9 18.75Z"/><path d="M32 12.5 32 27"/><path d="M48.5 37 37 43.7"/><path d="M15.5 37 27 43.7"/></svg>';

        function qrSvg(n) {
          var seed = 0x9e3779b9;
          function rnd() { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }
          var grid = [], r, c;
          for (r = 0; r < n; r++) { grid.push([]); for (c = 0; c < n; c++) grid[r].push(rnd() < 0.46 ? 1 : 0); }
          function finder(fr, fc) {
            for (var i = -1; i <= 7; i++) for (var j = -1; j <= 7; j++) {
              var y = fr + i, x = fc + j;
              if (y < 0 || x < 0 || y >= n || x >= n) continue;
              var inside = i >= 0 && i <= 6 && j >= 0 && j <= 6;
              var edge = i === 0 || i === 6 || j === 0 || j === 6;
              var core = i >= 2 && i <= 4 && j >= 2 && j <= 4;
              grid[y][x] = inside && (edge || core) ? 1 : 0;
            }
          }
          finder(0, 0); finder(0, n - 7); finder(n - 7, 0);
          var rects = '';
          for (r = 0; r < n; r++) for (c = 0; c < n; c++)
            if (grid[r][c]) rects += '<rect x="' + c + '" y="' + r + '" width="1" height="1"/>';
          return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + n + ' ' + n + '" fill="#000">' + rects + '</svg>';
        }

        function applyMask(el, svg) {
          if (!el) return;
          var u = 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")';
          el.style.maskImage = u; el.style.webkitMaskImage = u;
          el.style.maskSize = 'contain'; el.style.webkitMaskSize = 'contain';
          el.style.maskRepeat = 'no-repeat'; el.style.webkitMaskRepeat = 'no-repeat';
          el.style.maskPosition = 'center'; el.style.webkitMaskPosition = 'center';
        }

        applyMask(card.querySelector('[data-card-mark]'), cubeSvg);
        applyMask(card.querySelector('[data-card-qr]'), qrSvg(25));

        var queries = [
          matchMedia('(hover: hover)'),
          matchMedia('(pointer: fine)'),
          matchMedia('(prefers-reduced-motion: reduce)')
        ];
        var allow = false;
        function sync() { allow = queries[0].matches && queries[1].matches && !queries[2].matches; }
        queries.forEach(function (q) { q.addEventListener('change', sync); });
        sync();

        var rect = null, raf = null;
        function reset() {
          rect = null;
          if (raf) { cancelAnimationFrame(raf); raf = null; }
          card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
        }

        card.addEventListener('mouseenter', function () {
          if (allow) rect = card.getBoundingClientRect();
        });

        card.addEventListener('mousemove', function (e) {
          if (!allow) return;
          var r = rect || card.getBoundingClientRect();
          rect = r;
          var px = (e.clientX - r.left) / r.width;
          var py = (e.clientY - r.top) / r.height;
          var ry = (px - 0.5) * 10;
          var rx = (0.5 - py) * 10;
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(function () {
            card.style.transform = 'perspective(800px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
          });
        });

        card.addEventListener('mouseleave', reset);
      })();
    <% end %>
  </body>
</html>
